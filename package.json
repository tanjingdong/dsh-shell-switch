{
  "name": "dsh-shell-switch",
  "version": "0.1.0",
  "description": "Switch the DeepSeek Harness between its desktop client and the browser Web GUI over one shared profile, and report each switch where you want it.",
  "private": false,
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "routes.mjs",
    "client.js",
    "cordis.patch.yml",
    "src",
    "setup",
    "dsh-switch.cmd",
    "dsh-switch-menu.cmd"
  ],
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "shell",
    "desktop",
    "web",
    "windows"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
